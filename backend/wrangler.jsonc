{
  "$schema":"../node_modules/wrangler/config-schema.json",
  "name":"boundary-cricket-api",
  "main":"src/index.ts",
  "compatibility_date":"2026-05-15",
  "compatibility_flags":["nodejs_compat"],
  "vars":{"FRONTEND_ORIGIN":"https://hareeshreddys.github.io","ADMIN_EMAIL":"seepati.hareeshreddy@gmail.com"},
  "d1_databases":[{"binding":"DB","database_name":"boundary-cricket","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"BUCKET","bucket_name":"boundary-cricket-images"}],
  "triggers":{"crons":["*/5 * * * *"]}
}
