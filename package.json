{
  "name": "boundary-cricket-auction",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config dashboard/vite.config.ts",
    "build": "node scripts/prepare-auction.mjs && vite build --config dashboard/vite.config.ts && node scripts/service-worker.mjs",
    "dev:api": "wrangler dev --config backend/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config backend/wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config backend/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config backend/wrangler.jsonc",
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@cloudflare/workers-types": "4.20260515.1",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
